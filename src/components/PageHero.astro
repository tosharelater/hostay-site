---
/**
 * Intro for the standalone pages (not the homepage or 404): breadcrumb, eyebrow with a small
 * mark, title and lead on the left, aligned to the page grid; an isometric illustration on the
 * right in the same line-art language as the homepage (the map of Morocco for the Morocco page).
 */
import ModuleIcon from './ModuleIcon.astro';
import { dict, META, type Locale } from '../i18n';
import { href, abs } from '../lib/paths';
import MoroccoMap from './MoroccoMap.astro';

export type PageSymbol = 'product' | 'about' | 'morocco' | 'faq' | 'how';

interface Props {
  eyebrow: string;
  title: string;
  lead: string;
  symbol: PageSymbol;
  titleId?: string;
}
const { eyebrow, title, lead, symbol, titleId = 'page-title' } = Astro.props;
const locale: Locale = Astro.currentLocale === 'en' ? 'en' : 'fr';
const t = dict(locale);
// Which homepage icon illustrates each page.
const ICON: Record<Exclude<PageSymbol, 'morocco'>, number> = { product: 0, how: 3, about: 6, faq: 2 };
const crumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t.nav.home, item: abs(META[locale].home) },
    { '@type': 'ListItem', position: 2, name: eyebrow, item: abs(Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/') }
  ]
};
---

<header class="ph">
  <div class="wrap row">
    <div class="copy" data-reveal>
      <nav class="crumbs" aria-label={locale === 'fr' ? "Fil d'Ariane" : 'Breadcrumb'}>
        <a href={href(META[locale].home)}>{t.nav.home}</a>
        <span aria-hidden="true">›</span>
        <span aria-current="page">{eyebrow}</span>
      </nav>
      <p class="eyebrow">
        <span class="mark" aria-hidden="true" data-symbol={symbol}></span>
        {eyebrow}
      </p>
      <h1 class="title" id={titleId}>{title}</h1>
      <p class="lead">{lead}</p>
    </div>

    <figure class="visual" aria-hidden="true" data-reveal style="--d:120ms">
      {
        symbol === 'morocco' ? (
          <MoroccoMap id="hero-map" name={t.nav.morocco} mode="reveal" />
        ) : (
          <div class="tile">
            <ModuleIcon index={ICON[symbol]} />
          </div>
        )
      }
      <span class="spark s1"></span>
      <span class="spark s2"></span>
    </figure>
  </div>
</header>

<script type="application/ld+json" set:html={JSON.stringify(crumbs).replace(/</g, '\\u003c')} />

<style>
  .ph {
    padding: clamp(104px, 13vw, 136px) var(--gutter) clamp(40px, 6vw, 64px);
    border-bottom: 1px solid var(--rule);
    background:
      radial-gradient(ellipse 50% 70% at 0% 0%, var(--accent-soft) 0%, transparent 60%),
      radial-gradient(ellipse 40% 60% at 100% 30%, #eef0fd 0%, transparent 60%),
      linear-gradient(180deg, var(--panel) 0%, var(--page) 100%);
  }

  .row {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    gap: clamp(24px, 5vw, 64px);
    align-items: center;
  }

  .crumbs {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 22px;
    color: var(--muted);
    font-size: 13px;
  }

  .crumbs a {
    color: var(--ink-soft);
    text-decoration: underline;
    text-decoration-color: var(--accent-line);
    text-underline-offset: 3px;
  }

  .crumbs a:hover {
    color: var(--accent-deep);
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  .mark {
    width: 10px;
    height: 10px;
    border: 1.5px solid var(--accent);
    border-radius: 3px;
    background: var(--accent-soft);
    rotate: 45deg;
  }

  .title {
    max-width: 15ch;
    margin: 14px 0 0;
    font: 400 clamp(38px, 5.2vw, 66px) / 1.04 var(--serif);
    letter-spacing: -0.025em;
    color: var(--ink);
    text-wrap: balance;
  }

  .lead {
    max-width: 36rem;
    margin: 20px 0 0;
    color: var(--ink-soft);
    font-size: clamp(16.5px, 1.6vw, 19px);
    line-height: 1.6;
  }

  /* the illustration */
  .visual {
    position: relative;
    justify-self: end;
    width: min(100%, 380px);
    margin: 0;
  }

  .tile {
    padding: 26px 30px 18px;
    border: 1.5px solid var(--il-stroke);
    border-radius: 26px;
    background:
      radial-gradient(circle at 1px 1px, var(--dot) 1px, transparent 1.5px) 0 0 / 18px 18px,
      var(--white);
    box-shadow: 10px 10px 0 var(--accent-soft);
    animation: drift 7s ease-in-out infinite;
  }

  .tile :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  .spark {
    position: absolute;
    width: 16px;
    height: 16px;
    background: var(--accent-line);
    clip-path: polygon(50% 0, 62% 38%, 100% 50%, 62% 62%, 50% 100%, 38% 62%, 0 50%, 38% 38%);
    animation: twinkle 3.4s ease-in-out infinite;
  }

  .s1 {
    top: -14px;
    left: -10px;
  }

  .s2 {
    right: -14px;
    bottom: 18%;
    width: 11px;
    height: 11px;
    background: var(--il-amber);
    animation-delay: -1.7s;
  }

  @keyframes drift {
    50% {
      translate: 0 -8px;
    }
  }

  @keyframes twinkle {
    50% {
      scale: 0.6;
      opacity: 0.5;
    }
  }

  /* phones: text only, the illustration would squeeze the title */
  @media (max-width: 760px) {
    .row {
      grid-template-columns: minmax(0, 1fr);
    }

    .visual {
      display: none;
    }

    .crumbs {
      margin-bottom: 14px;
    }

    .title {
      font-size: clamp(32px, 9vw, 42px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tile,
    .spark {
      animation: none;
    }
  }
</style>
