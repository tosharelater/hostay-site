---
/**
 * Hero illustration: isometric line-art pieces of Hostay's world, composed as two flanks that
 * frame the headline. Left: the arrival (tall pillar and steps, horseshoe arch, suitcase, smart
 * lock, calendar, key). Right: the stay (riad, guest guide on a phone, olive trees, booklet).
 * Each group carries a depth for scroll parallax.
 */
import { at, box, floatSteps, stairs, onLeft, onRight, LS, sparkle, ring, P, T, extent, archPath, archFrame } from '../lib/iso';

interface Props {
  side: 'left' | 'right';
}
const { side } = Astro.props;

type G = { depth: number; float?: boolean; svg: string };
const P3 = (s: number, t: number, z: number) => {
  const [x, y] = at(s, t);
  return P(x, y, z);
};

/* Tall indigo pillar with floating steps running down from it */
const pillar = (s: number, t: number): G => {
  const [x, y] = at(s, t);
  return { depth: 0.06, svg: box(x, y, 0, 2.4, 2.4, 13.5, T.indigo) + floatSteps(x + 2.4, y + 0.4, 12.6, 5, 0.95, 1.18, 1.6, T.slate) };
};

/* Moroccan horseshoe arch, free-standing, with depth */
const arch = (s: number, t: number): G => {
  const [x, y] = at(s, t);
  const frame = (fill: string) => `<path d="${archFrame(0, 5.6, 7.6, 1.05)}" fill="${fill}" fill-rule="evenodd" ${LS}/>`;
  return { depth: 0.1, svg: onLeft(x, y - 1.1, 0, frame('#5c62cf')) + onLeft(x, y, 0, frame('var(--il-indigo)')) };
};

/* Low amber platform carrying a block and a suitcase */
const suitcase = (s: number, t: number): G => {
  const [x, y] = at(s, t);
  const sx = x + 5.2;
  const sy = y + 0.45;
  const handle = `<path d="M0.7 0 V0.6 Q0.7 1.05 1.15 1.05 H1.85 Q2.3 1.05 2.3 0.6 V0" fill="none" ${LS}/>`;
  const straps = `<path d="M0.8 0.4 V2.9 M2.2 0.4 V2.9" fill="none" ${LS}/><rect x="1.25" y="1.45" width="0.5" height="0.35" rx="0.06" fill="var(--il-amber)" ${LS}/>`;
  return {
    depth: 0.16,
    svg:
      box(x, y, 0, 10, 3.6, 2, T.amber) +
      box(x + 0.7, y + 0.5, 2, 4, 2.4, 2.6, T.slate) +
      box(sx, sy, 2, 3, 1.6, 3.4, T.indigo) +
      onLeft(sx, sy + 1.6, 2, straps) +
      onLeft(sx, sy + 0.8, 5.4, handle)
  };
};

/* Riad on a stepped base: arched door, windows, parapet and a domed tower */
const riad = (s: number, t: number): G => {
  const [x, y] = at(s, t);
  const door = `<path d="${archPath(2.9, 2.2, 3.5, 0.3)}" fill="var(--il-indigo)" ${LS}/><path d="M4 0 V2.9" fill="none" ${LS}/><circle cx="3.65" cy="1.4" r="0.1" fill="var(--il-amber)"/>`;
  const raised = (a: number, w = 1.1) => `<path d="${archPath(a, w, 1.6, 0.25)}" transform="translate(0 2.7)" fill="var(--il-indigo-2)" ${LS}/>`;
  let crenel = '';
  for (let i = 0; i < 7; i++) crenel += box(x + 2 + i * 1.12, y + 6.55, 8.2, 0.6, 0.5, 0.55, T.cream);
  const [dx, dy] = P(x + 7.9, y + 4, 12);
  const dome =
    `<path d="M${dx - 19} ${dy} A19 16 0 0 1 ${dx + 19} ${dy} Z" fill="var(--il-amber)" stroke="var(--il-stroke)" stroke-width="1.5" stroke-linejoin="round"/>` +
    `<path d="M${dx - 19} ${dy} Q${dx} ${dy + 7} ${dx + 19} ${dy}" fill="none" stroke="var(--il-stroke)" stroke-width="1.5"/>` +
    `<path d="M${dx} ${dy - 16} V${dy - 25}" stroke="var(--il-stroke)" stroke-width="1.5" stroke-linecap="round"/>` +
    `<circle cx="${dx}" cy="${dy - 27}" r="2.4" fill="var(--il-amber)" stroke="var(--il-stroke)" stroke-width="1.2"/>`;
  return {
    depth: 0.14,
    svg:
      box(x, y, 0, 13, 10, 1.3, T.slate) +
      box(x + 1, y + 1, 1.3, 11, 8, 1.3, T.slate) +
      box(x + 2, y + 2, 2.6, 8, 5, 5.6, T.cream) +
      onLeft(x + 2, y + 7, 2.6, door + raised(0.9) + raised(6)) +
      onRight(x + 10, y + 7, 2.6, raised(1.1) + raised(3)) +
      crenel +
      box(x + 7, y + 3, 8.2, 2.2, 2.2, 3.3, T.cream) +
      onLeft(x + 7, y + 5.2, 8.2, `<path d="${archPath(0.65, 0.9, 2.2, 0.2)}" fill="var(--il-indigo)" ${LS}/>`) +
      dome
  };
};

/* Amber plinth with a smart-lock door and a short staircase */
const lock = (s: number, t: number): G => {
  const [x, y] = at(s, t);
  let keypad = `<rect x="0.45" y="2" width="1.1" height="1.7" rx="0.14" fill="var(--il-indigo-2)" ${LS}/>`;
  for (let r = 0; r < 3; r++) for (let c = 0; c < 2; c++) keypad += `<circle cx="${0.78 + c * 0.45}" cy="${3.25 - r * 0.45}" r="0.11" fill="var(--il-stroke)"/>`;
  keypad += `<path d="M2.3 2.9 H2.85" fill="none" ${LS}/><circle cx="1" cy="4.3" r="0.16" fill="var(--il-sage)" ${LS}/>`;
  return {
    depth: 0.22,
    svg: box(x, y, 0, 7.6, 4.6, 2.8, T.amber) + box(x + 1.4, y + 1.6, 2.8, 3.2, 0.6, 6, T.slate) + onLeft(x + 1.4, y + 2.2, 2.8, keypad) + stairs(x + 7.6, y + 1.2, 2.4, 4, 0.85, 0.6, 2.4, T.slate)
  };
};

/* Tall pedestal with a phone showing the guest guide */
const phone = (s: number, t: number): G => {
  const [x, y] = at(s, t);
  const screen =
    `<rect x="0.2" y="0.35" width="1.6" height="3.1" rx="0.14" fill="var(--white)" ${LS}/>` +
    `<rect x="0.42" y="2.35" width="1.16" height="0.8" rx="0.1" fill="var(--il-indigo)" ${LS}/>` +
    `<path d="M0.45 1.9 H1.55 M0.45 1.45 H1.3 M0.45 1 H1.5" fill="none" ${LS}/>`;
  return { depth: 0.1, svg: box(x, y, 0, 3.4, 3.4, 9, T.slate) + box(x + 0.7, y + 1.4, 9, 2, 0.4, 3.8, T.ink) + onLeft(x + 0.7, y + 1.8, 9, screen) };
};

/* Low plinth with olive trees */
const olives = (s: number, t: number): G => {
  const [x, y] = at(s, t);
  let trees = '';
  (
    [
      [1.3, 1.3, 1.35],
      [3.8, 1.7, 1.75],
      [6.4, 1.2, 1.15]
    ] as const
  ).forEach(([tx, ty, r]) => {
    trees += box(x + tx, y + ty, 1.7, 0.32, 0.32, 1.3, T.ink);
    const [cx, cy] = P(x + tx + 0.16, y + ty + 0.16, 3 + r * 0.65);
    trees += `<circle cx="${cx}" cy="${cy}" r="${r * 14.5}" fill="var(--il-sage)" stroke="var(--il-stroke)" stroke-width="1.5"/><path d="M${cx - r * 5.5} ${cy + r * 2} q${r * 5.5} ${-r * 7.5} ${r * 11} 0" fill="none" stroke="var(--il-stroke)" stroke-width="1.2" stroke-linecap="round"/>`;
  });
  return { depth: 0.2, svg: box(x, y, 0, 8.4, 3.8, 1.7, T.cream) + trees };
};

/* Floating pieces (idle bob + stronger parallax) */
const calendar = (s: number, t: number, z: number): G => {
  const [x, y] = at(s, t);
  let cal = `<rect x="0" y="0" width="4.6" height="4" rx="0.3" fill="var(--white)" ${LS}/><path d="M0 3.05 H4.6 V3.7 A0.3 0.3 0 0 1 4.3 4 H0.3 A0.3 0.3 0 0 1 0 3.7 Z" fill="var(--il-indigo)" ${LS}/>`;
  for (let r = 0; r < 3; r++)
    for (let c = 0; c < 4; c++)
      cal += `<rect x="${0.45 + c * 1}" y="${2.15 - r * 0.78}" width="0.6" height="0.5" rx="0.08" fill="${r === 1 && c === 2 ? 'var(--il-amber)' : 'var(--il-slate-3)'}" stroke="var(--il-stroke)" stroke-width="1" vector-effect="non-scaling-stroke"/>`;
  cal += `<path d="M1 4 V4.45 M3.6 4 V4.45" fill="none" ${LS}/>`;
  return { depth: 0.34, float: true, svg: onLeft(x, y, z, cal) };
};
const key = (s: number, t: number, z: number): G => {
  const [x, y] = at(s, t);
  const k = `<path d="M0 0.85 A1.05 1.05 0 1 1 2.05 1.2 L5 1.2 L5 0.5 L4.4 0.5 L4.4 0.85 L3.85 0.85 L3.85 0.5 L3.3 0.5 L3.3 0.85 L2.05 0.85 A1.05 1.05 0 0 1 0 0.85 Z" fill="var(--il-amber)" ${LS}/><circle cx="0.8" cy="1.02" r="0.34" fill="var(--page)" ${LS}/>`;
  return { depth: 0.42, float: true, svg: onLeft(x, y, z, k) };
};
const booklet = (s: number, t: number, z: number): G => {
  const [x, y] = at(s, t);
  const book = `<rect x="0" y="0" width="3.2" height="4" rx="0.2" fill="var(--il-amber-2)" ${LS}/><rect x="0.4" y="0.4" width="2.4" height="3.2" rx="0.12" fill="var(--white)" ${LS}/><path d="M0.75 3 H2.45 M0.75 2.5 H2.1 M0.75 2 H2.45 M0.75 1.5 H1.75" fill="none" ${LS}/>`;
  return { depth: 0.3, float: true, svg: onRight(x, y, z, book) };
};

// Two flanks, built back-to-front so nearer pieces overlap farther ones.
const groups: G[] =
  side === 'left'
    ? [pillar(-12, -4), lock(4, -4), arch(-8, 4), suitcase(-2, 7), calendar(-5, -6, 8), key(7, 5, 10.5)]
    : [phone(10, -6), riad(0, 0), olives(9, 11), booklet(5, -9, 13)];
const accents =
  side === 'left'
    ? ring(...P3(-4, -4, 13), 9) + sparkle(...P3(-14, 2, 9), 11) + sparkle(...P3(4, 4, 10), 9)
    : ring(...P3(15, -2, 15), 10) + ring(...P3(16, 6, 6), 8) + sparkle(...P3(-2, -6, 15), 11) + sparkle(...P3(19, 1, 12), 9);

const all = groups.map((g) => g.svg).join('') + accents;
const viewBox = extent(all, 24);
---

<svg class:list={['scene', side]} viewBox={viewBox} aria-hidden="true" focusable="false">
  {
    groups.map((g) => (
      <g class="layer" data-depth={g.depth}>
        <g class:list={['inner', { float: g.float }]} set:html={g.svg} />
      </g>
    ))
  }
  <g class="layer" data-depth="0.26"><g class="accents" set:html={accents} /></g>
</svg>

<style>
  .scene {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .layer {
    will-change: transform;
  }

  .float {
    animation: bob 6s ease-in-out infinite;
    transform-box: fill-box;
  }

  .layer:nth-child(3n) .float {
    animation-delay: -2s;
  }

  .layer:nth-child(3n + 1) .float {
    animation-delay: -4s;
  }

  @keyframes bob {
    50% {
      transform: translateY(-8px);
    }
  }

  .accents :global(.spark) {
    transform-box: fill-box;
    transform-origin: center;
    animation: twinkle 3.2s ease-in-out infinite;
  }

  .accents :global(.spark:nth-of-type(2n)) {
    animation-delay: -1.6s;
  }

  @keyframes twinkle {
    50% {
      transform: scale(0.6) rotate(45deg);
      opacity: 0.55;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .float,
    .accents :global(.spark) {
      animation: none;
    }
  }
</style>
