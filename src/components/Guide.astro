---
/**
 * The guide: one character (a seasoned property manager in a suit) that stays fixed at the bottom centre of the screen from the hero
 * to the features. The sections scroll around him and leave him a slot; scripts/motion.ts sets
 * his state (hello, worried, searching with his back to us, saying "Hostay !", narrating) and
 * which line his speech bubble shows. He leaves once the features are told.
 * Decorative: everything he says is also on the page as text.
 */
import Logo from './Logo.astro';
import { dict, type Locale } from '../i18n';
import * as C from '../lib/character';
import { BRAIN, mouthAt } from '../lib/untangle';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = dict(locale);
const rays = Array.from({ length: 9 }, (_, i) => {
  const a = ((-160 + i * 17.5) * Math.PI) / 180;
  const p = (r: number) => `${(BRAIN[0] + r * Math.cos(a)).toFixed(1)} ${(BRAIN[1] + r * Math.sin(a)).toFixed(1)}`;
  return `M${p(110)} L${p(134)}`;
});
// Seen from the back, typing: upper arms reaching forward, elbows out.
const elbows = ['M146 560 C138 520 128 492 136 470 Q152 452 172 472 L200 560 Z', 'M454 560 C462 520 472 492 464 470 Q448 452 428 472 L400 560 Z'];
---

<div class="guide wave" data-guide data-pos="side" aria-hidden="true" style="--calm:1;--search:0;--turn:0;--worry:0">
  <div class="bubble" data-bubble>
    <p class="say on" data-line="hello">{t.hero.hello}</p>
    <p class="say hostay" data-line="hostay"><span class="mark"><Logo size={22} /> Hostay&nbsp;!</span><small>{t.untangle.appNote}</small></p>
    <p class="say" data-line="f0">{t.modules.say.intro}</p>
    {t.modules.say.lines.map((line, i) => <p class="say" data-line={`f${i + 1}`}>{line}</p>)}
    <p class="say" data-line={`f${t.modules.say.lines.length + 1}`}>{t.modules.say.stay}</p>
  </div>

  <svg viewBox={`0 0 ${C.PW} ${C.PH}`} focusable="false">
    <defs>
      <radialGradient id="guide-glow">
        <stop offset="0" stop-color="var(--accent-soft)" stop-opacity="1" />
        <stop offset="1" stop-color="var(--accent-soft)" stop-opacity="0" />
      </radialGradient>
    </defs>

    <circle class="glow" cx={BRAIN[0]} cy={BRAIN[1] + 60} r="250" fill="url(#guide-glow)" />
    <g class="rays">{rays.map((d) => <path d={d} pathLength="1" />)}</g>

    <g class="body">
      <!-- suit -->
      <path class="jacket" d={C.JACKET} />
      <g class="back-only">
        <g class="elbows">{elbows.map((d) => <path class="jacket" d={d} />)}</g>
        <path class="line seam" d={C.BACK_SEAM} />
        <path class="shirtw" d={C.COLLAR_BACK} />
      </g>
      <g class="front-only">
        <path class="shirtw" d={C.SHIRT_V} />
        <path class="tie" d={C.TIE} />
        <path class="tie" d={C.TIE_KNOT} />
        {C.SHIRT_COLLAR.map((d) => <path class="shirtw" d={d} />)}
        {C.LAPELS.map((d) => <path class="lapel" d={d} />)}
        <path class="shirtw" d={C.POCKET} />
      </g>
      <path class="skin" d={C.NECK} />

      <g class="head">
        <g class="ears">{C.EARS.map(([cx, cy]) => <ellipse class="skin" cx={cx} cy={cy} rx="12" ry="24" />)}</g>
        <path class="skin" d={C.HEAD} />
        <g class="front-only">
          <path class="beard" d={C.BEARD} />
          <path class="hair" d={C.HAIR} />
          {C.TEMPLES.map((d) => <path class="grey" d={d} />)}
          <path class="line part" d={C.PART} />
        </g>
        <path class="hair back-only" d={C.HAIR_BACK} />

        <g class="face front-only">
          <path class="line brow brow-l" d={C.BROWS[0]} />
          <path class="line brow brow-r" d={C.BROWS[1]} />
          {C.EYES.map(([cx, cy]) => <ellipse class="eye" cx={cx} cy={cy} rx="12" ry="9" />)}
          <g class="pupils">{C.EYES.map(([cx, cy]) => <circle cx={cx} cy={cy + 1} r="5" />)}</g>
          <g class="glasses">
            {C.LENSES.map((l) => <rect class="lens" x={l.x} y={l.y} width="56" height="38" rx="13" />)}
            <path class="line" d={C.BRIDGE} />
            {C.GLASS_ARMS.map((d) => <path class="line" d={d} />)}
          </g>
          <path class="line" d={C.NOSE} />
          {C.CHEEKS.map(([cx, cy]) => <ellipse class="cheek" cx={cx} cy={cy} rx="13" ry="7" />)}
          <path class="moustache" d={C.MOUSTACHE} />
          <path class="line mouth" d={mouthAt(0, 1)} data-mouth />
          <ellipse class="mouth-open" cx="300" cy="352" rx="14" ry="10" />
        </g>
        <g class="strands">{C.STRANDS.map((d) => <path class="line" d={d} />)}</g>
      </g>

      <g class="worry">
        <path class="sweat" d="M418 184 Q408 202 416 210 Q426 214 428 202 Q426 194 418 184 Z" />
        <text class="q q1" x="126" y="172">?</text>
        <text class="q q2" x="444" y="92">?</text>
        <text class="q q3" x="474" y="210">?</text>
      </g>

      <g class="arm" style={`transform-origin:${C.ARM_PIVOT[0]}px ${C.ARM_PIVOT[1]}px`}>
        <path class="jacket" d={C.SLEEVE} />
        <path class="shirtw" d={C.CUFF} />
        {C.FINGERS.map((f) => <rect class="skin" x="-7" y={-f.h} width="14" height={f.h + 8} rx="7" transform={`translate(${f.x} ${f.y}) rotate(${f.r})`} />)}
        <path class="skin" d={C.THUMB} />
        <path class="skin" d={C.PALM} />
      </g>
    </g>
  </svg>
</div>

<style>
  @property --look {
    syntax: '<number>';
    inherits: true;
    initial-value: 0;
  }

  .guide {
    --ponder: calc(var(--search) * (1 - var(--calm)));
    position: fixed;
    left: 50%;
    bottom: 0;
    z-index: 40;
    width: var(--guide-w);
    translate: -50% var(--exit, 0%);
    pointer-events: none;
    animation: guide-in 1.1s 0.6s var(--ease) both;
  }

  .guide:global(.worried) {
    animation:
      guide-in 1.1s 0.6s var(--ease) both,
      look 3.8s ease-in-out infinite;
  }

  @keyframes guide-in {
    from {
      opacity: 0;
      translate: -50% 40px;
    }
  }

  /* Glance left, hold, glance right, hold: the "what do I do first?" look (only while worried). */
  @keyframes look {
    0%,
    8% {
      --look: 0;
    }
    20%,
    42% {
      --look: -1;
    }
    58%,
    80% {
      --look: 1;
    }
    92%,
    100% {
      --look: 0;
    }
  }

  svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  svg :is(path, ellipse, circle, rect) {
    stroke: var(--il-stroke);
    stroke-width: 2.5;
    stroke-linejoin: round;
    stroke-linecap: round;
  }

  .skin {
    fill: #ecc9a3;
  }

  .jacket {
    fill: #2f3466;
  }

  .lapel {
    fill: #3d4380;
  }

  .shirtw {
    fill: var(--white);
  }

  .tie {
    fill: var(--accent);
  }

  .hair {
    fill: #4f5468;
  }

  .grey {
    fill: #b9bfcd;
    stroke: none !important;
  }

  .part {
    stroke: #8a90a3 !important;
    stroke-width: 2 !important;
  }

  .beard {
    fill: #8a8f9f;
    opacity: 0.45;
    stroke: none !important;
  }

  .moustache {
    fill: #4f5468;
    stroke-width: 1.5 !important;
  }

  .lens {
    fill: var(--white);
    fill-opacity: 0.18;
    stroke-width: 3 !important;
  }

  .seam {
    stroke: #4a5090 !important;
    stroke-width: 2 !important;
  }

  .line {
    fill: none;
  }

  .brow {
    stroke-width: 5;
  }

  .strands .line {
    stroke: #4f5468;
    stroke-width: 3;
  }

  .eye {
    fill: var(--white);
  }

  .pupils circle {
    fill: var(--il-stroke);
    stroke: none;
  }

  .cheek {
    fill: var(--il-amber-2);
    stroke: none !important;
    opacity: calc(0.3 + var(--calm) * 0.55);
  }

  /* front / back */
  .back-only {
    opacity: var(--turn);
  }

  .front-only {
    opacity: clamp(0, calc(1 - var(--turn) * 2), 1);
  }

  /* worried: glancing left/right; searching: still and focused; calm: relaxed */
  .head {
    transform-box: view-box;
    transform-origin: 300px 430px;
    rotate: calc(var(--look) * 3deg * var(--worry));
  }

  .face {
    translate: calc(var(--look) * 13px * var(--worry)) calc(var(--calm) * -3px);
  }

  .ears {
    translate: calc(var(--look) * -5px * var(--worry)) 0;
  }

  .pupils {
    translate: calc(var(--look) * 6px * var(--worry)) calc(var(--calm) * -2px);
  }

  .brow {
    transform-box: fill-box;
    transform-origin: center;
  }

  .brow-l {
    rotate: calc(var(--worry) * -13deg);
    translate: 0 calc(var(--calm) * -5px);
  }

  .brow-r {
    rotate: calc(var(--worry) * 13deg);
    translate: 0 calc(var(--calm) * -5px);
  }

  .strands {
    transform-box: view-box;
    transform-origin: 300px 92px;
    rotate: calc(var(--look) * 4deg * var(--worry));
    opacity: var(--worry); /* a few hairs out of place, only while worried */
  }

  .worry {
    opacity: var(--worry);
  }

  .sweat {
    fill: var(--white);
    stroke-width: 2 !important;
    animation: drip 2.6s ease-in infinite;
  }

  @keyframes drip {
    0%,
    30% {
      translate: 0 0;
    }
    100% {
      translate: 2px 26px;
      opacity: 0;
    }
  }

  .q {
    fill: var(--accent);
    font: italic 400 46px/1 var(--serif);
    animation: bob 3s ease-in-out infinite;
  }

  .q2 {
    font-size: 36px;
    animation-delay: -1s;
  }

  .q3 {
    font-size: 30px;
    animation-delay: -2s;
  }

  @keyframes bob {
    50% {
      translate: 0 -8px;
    }
  }

  /* waving hello */
  .arm {
    transform-box: view-box;
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .guide:global(.wave) .arm {
    opacity: 1;
    animation: wave 2.4s ease-in-out infinite;
  }

  @keyframes wave {
    0%,
    60%,
    100% {
      rotate: 0deg;
    }
    10%,
    30%,
    50% {
      rotate: -14deg;
    }
    20%,
    40% {
      rotate: 6deg;
    }
  }

  /* typing, seen from the back: elbows tap in turn, head and shoulders follow */
  .guide:global(.typing) .elbows path {
    animation: tap 0.36s ease-in-out infinite alternate;
  }

  .guide:global(.typing) .elbows path + path {
    animation-delay: -0.18s;
  }

  .guide:global(.typing) .body {
    animation: focus 1.6s ease-in-out infinite;
  }

  @keyframes tap {
    to {
      translate: 0 7px;
    }
  }

  @keyframes focus {
    50% {
      translate: 0 -4px;
      rotate: 0.8deg;
    }
  }

  .body {
    transform-box: view-box;
    transform-origin: 300px 560px;
  }

  /* talking */
  .mouth-open {
    fill: var(--il-stroke);
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
  }

  .guide:global(.talking) .mouth-open {
    opacity: 1;
    animation: talk 0.5s ease-in-out infinite alternate;
  }

  .guide:global(.talking) .mouth {
    opacity: 0;
  }

  @keyframes talk {
    from {
      scale: 1 0.25;
    }
    to {
      scale: 0.85 1;
    }
  }

  /* joy */
  .glow {
    stroke: none !important;
    opacity: 0;
    transition: opacity 0.6s ease;
  }

  .rays path {
    fill: none;
    stroke: var(--accent);
    stroke-width: 3;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 0.6s var(--ease);
  }

  .guide:global(.joy) .glow {
    opacity: 1;
  }

  .guide:global(.joy) .rays path {
    stroke-dashoffset: 0;
  }

  /* speech bubble: beside his head in the hero, above it elsewhere */
  .bubble {
    position: absolute;
    left: 76%;
    bottom: 70%;
    display: grid;
    width: max-content;
    max-width: 250px;
    padding: 12px 15px;
    border: 1.5px solid var(--il-stroke);
    border-radius: 16px 16px 16px 4px;
    background: var(--white);
    box-shadow: 4px 4px 0 var(--il-slate-3);
    transition:
      left 0.5s var(--ease),
      bottom 0.5s var(--ease),
      translate 0.5s var(--ease),
      opacity 0.35s ease,
      border-radius 0.4s ease;
  }

  .guide[data-pos='top'] .bubble {
    left: 50%;
    bottom: 104%;
    max-width: 320px;
    border-radius: 16px;
    translate: -50% 0;
  }

  .guide:global(.quiet) .bubble {
    opacity: 0;
    translate: 0 10px;
  }

  .guide[data-pos='top']:global(.quiet) .bubble {
    translate: -50% 10px;
  }

  .say {
    grid-area: 1 / 1;
    color: var(--ink);
    font: 400 16px/1.38 var(--serif);
    opacity: 0;
    translate: 0 6px;
    transition:
      opacity 0.35s ease,
      translate 0.45s var(--ease);
  }

  .say:global(.on) {
    opacity: 1;
    translate: 0 0;
  }

  .hostay {
    display: grid;
    justify-items: center;
    gap: 2px;
    text-align: center;
  }

  .mark {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--accent-deep);
    font: 700 26px/1.1 var(--sans);
    letter-spacing: -0.02em;
  }

  .mark :global(svg) {
    width: 22px;
    height: auto;
    color: var(--accent);
  }

  .hostay small {
    color: var(--ink-soft);
    font: italic 400 14px/1.3 var(--serif);
  }

  @media (max-width: 860px) {
    .bubble {
      left: 50%;
      bottom: 100%;
      max-width: min(300px, 82vw);
      padding: 10px 12px;
      border-radius: 14px;
      translate: -50% 0;
    }

    .say {
      font-size: 14px;
      text-align: center;
    }

    .mark {
      font-size: 21px;
    }
  }

  /* phones: while he tells the features he steps aside to the bottom-right corner, so the
     cards stay readable; his bubble sits to his left */
  @media (max-width: 860px) {
    .guide[data-zone='features'] {
      left: auto;
      right: 6px;
      width: min(30vw, 116px);
      translate: 0 var(--exit, 0%);
      transition: width 0.4s var(--ease);
    }

    .guide[data-zone='features'] .bubble {
      left: auto;
      right: 92%;
      bottom: 40%;
      width: min(62vw, 250px);
      max-width: none;
      translate: 0 0;
      border-radius: 14px 14px 4px 14px;
    }

    .guide[data-zone='features'] .say {
      font-size: 13px;
      text-align: left;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .guide,
    .guide:global(.wave) .arm,
    .guide:global(.typing) .elbows path,
    .guide:global(.typing) .body,
    .guide:global(.talking) .mouth-open,
    .sweat,
    .q {
      animation: none;
    }
  }
</style>
