---
import { dict, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = dict(locale).faq;
---

<section class="sec faq" id="faq" aria-labelledby="faq-title">
  <div class="wrap grid">
    <div data-reveal>
      <p class="eyebrow">{t.eyebrow}</p>
      <h2 class="h2" id="faq-title">{t.title}</h2>
    </div>
    <div class="list" data-reveal style="--d:120ms">
      {
        t.items.map((it) => (
          <details>
            <summary>
              <span>{it.q}</span>
              <i aria-hidden="true" />
            </summary>
            <p>{it.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq {
    background: var(--panel);
    border-block: 1px solid var(--rule);
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 40px 64px;
    align-items: start;
  }

  .list {
    border-top: 1px solid var(--rule);
  }

  details {
    border-bottom: 1px solid var(--rule);
  }

  summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 22px 2px;
    cursor: pointer;
    list-style: none;
    font: 400 21px/1.3 var(--serif);
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary i {
    position: relative;
    flex: none;
    width: 26px;
    height: 26px;
    border: 1px solid var(--line);
    border-radius: 50%;
  }

  summary i::before,
  summary i::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 10px;
    height: 1.5px;
    background: var(--accent);
    translate: -50% -50%;
    transition: rotate 0.35s var(--ease);
  }

  summary i::after {
    rotate: 90deg;
  }

  details[open] summary i::after {
    rotate: 0deg;
  }

  details p {
    max-width: 620px;
    margin: 0 0 24px;
    color: var(--ink-soft);
    line-height: 1.65;
  }

  @media (max-width: 860px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
