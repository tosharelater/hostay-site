---
import HeroScene from './HeroScene.astro';
import { dict, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = dict(locale).hero;
---

<section class="hero" aria-labelledby="hero-title" data-hero>
  <div class="copy">
    <h1 id="hero-title">
      <span class="line">{t.lineA}</span>
      <span class="line">
        {t.lineB}
        <em class="accent">
          {t.accent}
          <svg class="swash" viewBox="0 0 220 34" preserveAspectRatio="none" aria-hidden="true" focusable="false">
            <path d="M4 22 C 48 8, 110 6, 214 14" pathLength="1"></path>
            <path d="M14 30 C 70 18, 132 16, 196 24" pathLength="1"></path>
          </svg>
        </em>
      </span>
    </h1>
    <p class="lead">{t.lead}</p>
    <div class="actions">
      <a class="btn btn-offset" href="#modules">{t.primary}</a>
      <a class="btn btn-ghost" href="#notify">{t.secondary}</a>
    </div>
  </div>
  <div class="flank flank-left"><HeroScene side="left" /></div>
  <div class="flank flank-right"><HeroScene side="right" /></div>
  <!-- the guide character (Guide.astro) stands here, fixed, and stays with us as we scroll -->
  <div class="guide-slot" aria-hidden="true"></div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 100svh;
    padding: clamp(112px, 15vh, 148px) var(--gutter) 0;
    text-align: center;
    overflow-x: clip;
  }

  .copy {
    position: relative;
    z-index: 2;
    width: min(860px, 100%);
    margin-inline: auto;
  }

  h1 {
    font-size: clamp(40px, 6.6vw, 76px);
    line-height: 1.04;
    letter-spacing: -0.018em;
  }

  .line {
    display: block;
    animation: lift 0.9s 0.05s var(--ease) both;
  }

  .line + .line {
    animation-delay: 0.17s;
  }

  .accent {
    position: relative;
    display: inline-block;
    color: var(--accent);
    font-style: italic;
  }

  .swash {
    position: absolute;
    left: -3%;
    right: -3%;
    bottom: -0.2em;
    width: 106%;
    height: 0.42em;
    overflow: visible;
  }

  .swash path {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: draw 1.1s 0.75s var(--ease) forwards;
    vector-effect: non-scaling-stroke;
  }

  .swash path + path {
    stroke-width: 1.6;
    opacity: 0.7;
    animation-delay: 0.95s;
  }

  .lead {
    max-width: 560px;
    margin: 26px auto 0;
    color: var(--ink-soft);
    font-size: 16.5px;
    line-height: 1.6;
    animation: lift 0.9s 0.15s var(--ease) both;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-top: 28px;
    animation: lift 0.9s 0.2s var(--ease) both;
  }

  /* Sized so the whole scene fits under the copy on the first screen (viewBox ≈ 1.85:1). */
  /* The world frames the headline from both sides; our character says hello in the middle. */
  .flank {
    position: absolute;
    bottom: 0;
    z-index: 1;
    width: min(35vw, 540px);
    pointer-events: none;
    animation: rise 1.2s 0.45s var(--ease) both;
  }

  .flank-left {
    left: max(1.5vw, calc(50% - 720px));
  }

  .flank-right {
    right: max(1.5vw, calc(50% - 720px));
    animation-delay: 0.55s;
  }

  .guide-slot {
    width: var(--guide-w);
    aspect-ratio: 600 / 560;
    margin: auto auto 0;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
  }

  /* text only moves: it is painted from the very first frame */
  @keyframes lift {
    from {
      transform: translateY(14px);
    }
  }

  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @media (max-width: 860px) {
    .flank {
      width: 50vw;
      opacity: 0.9;
    }

    .flank-left {
      left: -8vw;
    }

    .flank-right {
      right: -8vw;
    }

    .guide-slot {
      margin-top: 96px;
    }

    .hero {
      padding-top: 92px;
    }

    h1 {
      font-size: clamp(34px, 9.4vw, 44px);
    }

    .lead {
      margin-top: 16px;
      font-size: 15.5px;
    }
  }
</style>
