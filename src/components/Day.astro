---
/**
 * A day with Hostay: an example turnover day at a riad. The section stays pinned while the sun
 * crosses the day from 06:00 to 22:00; each moment lights up as the sun reaches it
 * (scripts/motion.ts). Example content, labelled as such.
 */
import { dict, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = dict(locale).day;
const DAY_START = 6;
const DAY_LEN = 16;
const events = t.events.map((e) => {
  const [h = 0, m = 0] = e.time.split(':').map(Number);
  return { ...e, at: (h + m / 60 - DAY_START) / DAY_LEN };
});
const hours = [6, 10, 14, 18, 22];
---

<section class="day" aria-labelledby="day-title" data-day>
  <div class="pin">
    <div class="wrap">
      <div class="head" data-reveal>
        <p class="eyebrow">{t.eyebrow}</p>
        <h2 class="h2" id="day-title">{t.title}</h2>
        <p class="lede">{t.lead} <span class="tag">{t.example}</span></p>
      </div>

      <div class="sky" aria-hidden="true">
        <svg viewBox="0 0 1000 160" preserveAspectRatio="none" focusable="false">
          <path class="arc" d="M0 150 Q500 -60 1000 150" />
        </svg>
        <span class="sun" data-sun><i></i></span>
      </div>

      <ol class="timeline">
        {
          events.map((e) => (
            <li class="moment" data-moment data-at={e.at.toFixed(4)} style={`--at:${e.at}`}>
              <span class="dot" aria-hidden="true" />
              <time>{e.time}</time>
              <h3>{e.title}</h3>
              <p>{e.body}</p>
            </li>
          ))
        }
      </ol>
      <div class="ruler" aria-hidden="true">
        <span class="fill" data-day-fill></span>
        {hours.map((h) => <b style={`left:${((h - DAY_START) / DAY_LEN) * 100}%`}>{String(h).padStart(2, '0')}:00</b>)}
      </div>
    </div>
  </div>
</section>

<style>
  .day {
    height: 210vh;
  }

  .pin {
    position: sticky;
    top: 0;
    display: grid;
    align-items: center;
    min-height: 100vh;
    min-height: 100svh;
    padding: 88px var(--gutter) 32px;
    overflow: hidden;
  }

  .head {
    max-width: 620px;
  }

  .tag {
    display: inline-block;
    margin-left: 6px;
    padding: 3px 9px;
    border: 1px solid var(--accent-line);
    border-radius: 999px;
    color: var(--accent-deep);
    font-size: 12px;
    font-weight: 600;
    vertical-align: 2px;
  }

  /* the sun crossing the day */
  .sky {
    position: relative;
    height: 120px;
    margin-top: 28px;
  }

  .sky svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .arc {
    fill: none;
    stroke: var(--line);
    stroke-width: 1.5;
    stroke-dasharray: 3 8;
    vector-effect: non-scaling-stroke;
  }

  .sun {
    position: absolute;
    left: var(--sun-x, 0%);
    top: var(--sun-y, 94%);
    width: 44px;
    height: 44px;
    translate: -50% -50%;
  }

  .sun i {
    position: absolute;
    inset: 0;
    border: 2px solid var(--il-stroke);
    border-radius: 50%;
    background: var(--il-amber);
    box-shadow: 0 0 0 10px rgba(240, 180, 110, 0.22);
  }

  .sun::before {
    content: '';
    position: absolute;
    inset: -14px;
    border-radius: 50%;
    background: repeating-conic-gradient(var(--il-amber) 0 4deg, transparent 4deg 30deg);
    mask: radial-gradient(circle, transparent 58%, #000 60%, #000 70%, transparent 72%);
    animation: spin 18s linear infinite;
  }

  @keyframes spin {
    to {
      rotate: 360deg;
    }
  }

  /* the moments of the day */
  .timeline {
    position: relative;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 14px;
    margin: 18px 0 0;
    padding: 0;
    list-style: none;
  }

  .moment {
    position: relative;
    padding: 16px 16px 18px;
    border: 1px solid var(--rule);
    border-radius: 14px;
    background: var(--panel);
    color: var(--muted);
    translate: 0 10px;
    transition:
      opacity 0.45s ease,
      translate 0.5s var(--ease),
      border-color 0.35s ease,
      box-shadow 0.4s ease,
      background-color 0.35s ease;
  }

  .moment:global(.on) {
    color: var(--ink);
    translate: 0 0;
    border-color: var(--accent-line);
    background: var(--white);
    box-shadow: 5px 5px 0 var(--accent-soft);
  }

  .dot {
    position: absolute;
    top: 18px;
    right: 16px;
    width: 12px;
    height: 12px;
    border: 2px solid var(--line);
    border-radius: 50%;
    transition:
      background-color 0.35s ease,
      border-color 0.35s ease;
  }

  .moment:global(.on) .dot {
    border-color: var(--il-sage);
    background: var(--il-sage);
  }

  time {
    color: var(--accent);
    font: italic 400 17px/1 var(--serif);
  }

  h3 {
    margin-top: 8px;
    color: inherit;
    font-size: 21px;
  }

  .moment p {
    margin-top: 6px;
    color: var(--ink-soft);
    font-size: 13.5px;
    line-height: 1.5;
  }

  .ruler {
    position: relative;
    height: 34px;
    margin-top: 22px;
    border-top: 2px solid var(--rule);
  }

  .fill {
    position: absolute;
    left: 0;
    top: -2px;
    width: 100%;
    border-top: 2px solid var(--accent);
    transform-origin: left;
    scale: var(--day, 0) 1;
  }

  .ruler b {
    position: absolute;
    top: 8px;
    color: var(--muted);
    font-size: 12px;
    font-weight: 500;
    translate: -50% 0;
  }

  .ruler b:first-of-type {
    translate: 0 0;
  }

  .ruler b:last-of-type {
    translate: -100% 0;
  }

  @media (max-width: 960px) {
    /* on phones the day simply scrolls; moments light up as they come */
    .day {
      height: auto;
    }

    .pin {
      position: static;
      min-height: 0;
      padding-block: 72px;
    }

    .sky,
    .ruler {
      display: none;
    }

    .timeline {
      grid-template-columns: 1fr;
      gap: 8px;
      margin-top: 18px;
    }

    .moment {
      padding: 12px 14px;
    }

    .moment p {
      font-size: 13px;
    }

    h3 {
      font-size: 18px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .day {
      height: auto;
    }

    .pin {
      position: static;
    }

    .sun::before {
      animation: none;
    }

    .moment {
      translate: none;
    }
  }
</style>
