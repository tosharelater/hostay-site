---
import PageHero from '../PageHero.astro';
import PageCta from '../PageCta.astro';
import { dict, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const p = dict(locale).pages.faq;
---

<article class="fp">
  <PageHero symbol="faq" eyebrow={p.eyebrow} title={p.title} lead={p.lead} />

  <section class="sec groups" aria-labelledby="page-title">
    <div class="wrap">
      <div class="search" data-reveal>
        <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="9" cy="9" r="6" /><path d="M13.5 13.5 L18 18" /></svg>
        <label class="sr-only" for="faq-search">{p.search}</label>
        <input id="faq-search" type="search" placeholder={p.search} autocomplete="off" data-faq-search />
      </div>
      <p class="empty" data-faq-empty hidden>{p.empty}</p>
      {
        p.groups.map((g, gi) => (
          <div class="group" data-reveal style={`--d:${gi * 60}ms`} data-faq-group>
            <h2 class="group-title">{g.title}</h2>
            <div class="list">
              {g.items.map((it) => (
                <details data-smooth>
                  <summary>
                    <span>{it.q}</span>
                    <i aria-hidden="true" />
                  </summary>
                  <div class="answer">
                    <p>{it.a}</p>
                  </div>
                </details>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <PageCta locale={locale} />
</article>

<style>
  .search {
    display: flex;
    align-items: center;
    gap: 10px;
    max-width: 520px;
    margin-bottom: 36px;
    padding: 0 16px;
    border: 1.5px solid var(--line);
    border-radius: 999px;
    background: var(--white);
    transition:
      border-color 0.25s ease,
      box-shadow 0.25s ease;
  }

  .search:focus-within {
    border-color: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-soft);
  }

  .search svg {
    flex: none;
    width: 18px;
    height: 18px;
    fill: none;
    stroke: var(--muted);
    stroke-width: 1.8;
    stroke-linecap: round;
  }

  .search input {
    flex: 1;
    min-width: 0;
    height: 50px;
    border: 0;
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-size: 16px;
    outline: none;
  }

  .empty {
    margin-bottom: 28px;
    color: var(--ink-soft);
    font: italic 400 18px/1.4 var(--serif);
  }

  .groups {
    padding-top: clamp(40px, 6vw, 64px);
  }

  .group {
    margin-bottom: clamp(40px, 6vw, 64px);
  }

  .group-title {
    margin: 0 0 14px;
    color: var(--accent);
    font: 600 13px/1 var(--sans);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .list {
    border-top: 1px solid var(--rule);
  }

  details {
    border-bottom: 1px solid var(--rule);
  }

  summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 26px 2px;
    cursor: pointer;
    list-style: none;
    font: 400 clamp(20px, 2.5vw, 28px) / 1.3 var(--serif);
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary i {
    position: relative;
    flex: none;
    width: 28px;
    height: 28px;
    border: 1px solid var(--line);
    border-radius: 50%;
  }

  summary i::before,
  summary i::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 10px;
    height: 1.5px;
    background: var(--accent);
    translate: -50% -50%;
    transition: rotate 0.35s var(--ease);
  }

  summary i::after {
    rotate: 90deg;
  }

  details[open] summary i::after {
    rotate: 0deg;
  }

  details p {
    max-width: 44rem;
    margin: 0 0 26px;
    color: var(--ink-soft);
    font-size: 17px;
    line-height: 1.7;
  }
</style>
