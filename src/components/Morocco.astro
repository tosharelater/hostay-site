---
/**
 * Made in Morocco: the section stays pinned while the map of Morocco comes in. The outline
 * draws itself, the land fills in, then the name and the Hostay mark appear
 * (scripts/motion.ts sets --draw, --fill and --mark on the map).
 */
import MoroccoMap from './MoroccoMap.astro';
import { dict, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = dict(locale);
const m = t.morocco;
---

<section class="morocco" aria-labelledby="ma-title" data-morocco>
  <div class="pin">
    <div class="wrap grid">
      <div class="copy" data-reveal>
        <p class="eyebrow">{m.eyebrow}</p>
        <h2 class="h2" id="ma-title">{m.title}</h2>
        <p class="lede">{m.lead}</p>
        <p class="tagline"><i aria-hidden="true"></i>{m.tagline}</p>
      </div>
      <figure class="map">
        <MoroccoMap id="home-map" name={t.nav.morocco} mode="scroll" />
      </figure>
    </div>
  </div>
</section>

<style>
  .morocco {
    height: 190vh;
  }

  .pin {
    position: sticky;
    top: 0;
    display: grid;
    align-items: center;
    min-height: 100vh;
    min-height: 100svh;
    padding: 84px var(--gutter) 24px;
    overflow: hidden;
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 48px;
    align-items: center;
  }

  .h2 {
    font-size: clamp(34px, 4.4vw, 56px);
  }

  .tagline {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 26px;
    color: var(--accent-deep);
    font: italic 400 20px/1.2 var(--serif);
  }

  .tagline i {
    width: 34px;
    border-top: 2.5px dashed var(--accent);
  }

  .map {
    width: min(100%, calc((100svh - 130px) * 540 / 590));
    margin: 0 auto;
  }

  @media (max-width: 860px) {
    .morocco {
      height: 170vh;
    }

    .pin {
      padding-top: 76px;
    }

    .grid {
      grid-template-columns: 1fr;
      gap: 8px;
    }

    .h2 {
      font-size: 28px;
    }

    .copy .lede {
      font-size: 15px;
    }

    .tagline {
      margin-top: 10px;
      font-size: 17px;
    }

    .map {
      width: min(86%, calc((100svh - 400px) * 540 / 590));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .morocco {
      height: auto;
    }

    .pin {
      position: static;
    }
  }
</style>
