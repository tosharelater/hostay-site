---
/** Small isometric line-art icon for each module (same language as the hero scene). */
import { box, onLeft, onRight, LS, P, T, extent, archPath } from '../lib/iso';

interface Props {
  index: number;
}
const { index } = Astro.props;

const base = box(0, 0, 0, 6, 6, 0.7, T.slate);
let art = '';

switch (index) {
  case 0: {
    // Calendar card standing on the tile
    let cal = `<rect x="0" y="0" width="4" height="3.6" rx="0.3" fill="var(--white)" ${LS}/><path d="M0 2.7 H4 V3.3 A0.3 0.3 0 0 1 3.7 3.6 H0.3 A0.3 0.3 0 0 1 0 3.3 Z" fill="var(--il-indigo)" ${LS}/>`;
    for (let r = 0; r < 3; r++)
      for (let c = 0; c < 3; c++)
        cal += `<rect x="${0.5 + c * 1.1}" y="${1.9 - r * 0.7}" width="0.7" height="0.45" rx="0.08" fill="${r === 1 && c === 1 ? 'var(--il-amber)' : 'var(--il-slate-3)'}" stroke="var(--il-stroke)" stroke-width="1" vector-effect="non-scaling-stroke"/>`;
    art = box(1, 2.6, 0.7, 4, 0.5, 0.4, T.indigo) + onLeft(1, 3.1, 1.1, cal);
    break;
  }
  case 1: {
    // Guest ID card with a check badge
    const card =
      `<rect x="0" y="0" width="4.2" height="2.9" rx="0.3" fill="var(--white)" ${LS}/>` +
      `<circle cx="1.1" cy="1.65" r="0.55" fill="var(--il-indigo-2)" ${LS}/><path d="M0.45 0.55 Q1.1 1.05 1.75 0.55" fill="none" ${LS}/>` +
      `<path d="M2.2 2 H3.6 M2.2 1.5 H3.3 M2.2 1 H3.6" fill="none" ${LS}/>`;
    const badge = `<circle cx="3.9" cy="2.9" r="0.6" fill="var(--il-sage)" ${LS}/><path d="M3.6 2.9 L3.85 2.65 L4.25 3.15" fill="none" ${LS}/>`;
    art = box(0.9, 2.5, 0.7, 4.4, 0.45, 0.35, T.amber) + onLeft(0.9, 2.95, 1.05, card + badge);
    break;
  }
  case 2: {
    // Phone with the guest guide
    const screen =
      `<rect x="0.2" y="0.3" width="1.8" height="3.3" rx="0.16" fill="var(--white)" ${LS}/>` +
      `<rect x="0.42" y="2.55" width="1.36" height="0.8" rx="0.1" fill="var(--il-indigo)" ${LS}/>` +
      `<path d="M0.45 2 H1.7 M0.45 1.5 H1.4 M0.45 1 H1.7" fill="none" ${LS}/>`;
    art = box(1.9, 2.4, 0.7, 2.2, 0.45, 4, T.ink) + onLeft(1.9, 2.85, 0.7, screen);
    break;
  }
  case 3: {
    // Clipboard checklist and a cleaning block
    let list = `<rect x="0" y="0" width="3.2" height="3.9" rx="0.25" fill="var(--white)" ${LS}/><rect x="1" y="3.6" width="1.2" height="0.5" rx="0.1" fill="var(--il-slate-2)" ${LS}/>`;
    [2.9, 2.1, 1.3].forEach((b, i) => {
      list += `<rect x="0.35" y="${b - 0.3}" width="0.5" height="0.5" rx="0.08" fill="${i < 2 ? 'var(--il-sage)' : 'var(--white)'}" ${LS}/><path d="M1.1 ${b - 0.05} H2.8" fill="none" ${LS}/>`;
    });
    art = box(3.6, 1, 0.7, 1.6, 1.6, 1.6, T.amber) + onLeft(0.8, 3.3, 0.7, list);
    break;
  }
  case 4: {
    // Dashboard bars
    art = box(0.9, 2, 0.7, 1.2, 1.2, 1.6, T.slate) + box(2.4, 2, 0.7, 1.2, 1.2, 3, T.indigo) + box(3.9, 2, 0.7, 1.2, 1.2, 2.2, T.amber);
    break;
  }
  case 5: {
    // Smart lock slab with keypad
    let pad = `<rect x="0.45" y="1.9" width="1.1" height="1.6" rx="0.14" fill="var(--il-indigo-2)" ${LS}/>`;
    for (let r = 0; r < 3; r++) for (let c = 0; c < 2; c++) pad += `<circle cx="${0.78 + c * 0.45}" cy="${3.1 - r * 0.42}" r="0.1" fill="var(--il-stroke)"/>`;
    pad += `<path d="M2.2 2.7 H2.7" fill="none" ${LS}/>`;
    art = box(1.5, 2.3, 0.7, 3, 0.55, 5, T.slate) + onLeft(1.5, 2.85, 0.7, pad);
    break;
  }
  default: {
    // Owners: a small riad with an arched door
    let crenel = '';
    for (let i = 0; i < 4; i++) crenel += box(1.2 + i * 1, 4.65, 3.9, 0.5, 0.4, 0.45, T.cream);
    art =
      box(1.2, 1.5, 0.7, 3.8, 3.5, 3.2, T.cream) +
      onLeft(1.2, 5, 0.7, `<path d="${archPath(1.3, 1.2, 2, 0.28)}" fill="var(--il-indigo)" ${LS}/>`) +
      onRight(5, 5, 0.7, `<path d="${archPath(1.3, 0.8, 2.4, 0.2)}" transform="translate(0 0.4)" fill="var(--il-indigo-2)" ${LS}/>`) +
      crenel;
  }
}

const svg = base + art;
const viewBox = extent(svg, 10);
void P;
---

<svg class="micon" viewBox={viewBox} aria-hidden="true" focusable="false" set:html={svg} />

<style>
  .micon {
    width: 100%;
    height: 100%;
    overflow: visible;
  }
</style>
