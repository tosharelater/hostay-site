# Canonical origin (canonical links, hreflang, Open Graph, sitemap).
PUBLIC_SITE_URL=https://hostayapp.com
# The Hostay web app: "Se connecter / Sign in".
PUBLIC_APP_URL=https://app.hostayapp.com
# Where the "Restez informé" form POSTs JSON { email, lang }. Empty = validates but does not send.
# The endpoint must validate again server-side, rate-limit and filter spam.
PUBLIC_NOTIFY_ENDPOINT=
